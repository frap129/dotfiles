enabled_backends = ["cargo", "nix", "npm", "uv"]
hostname_groups_enabled = true

[cargo]
binstall = true

[hostname_enabled_backends]
{% if yadm.class == "Server" %}
{{ yadm.hostname }} = []
{% else %}
{{ yadm.hostname }} = ["flatpak"]
{% endif %}

[hostname_groups]
{% if yadm.class == "Server" %}
{{ yadm.hostname }} = ["common"]
{% else %}
{% if yadm.class == "Work" %}
{{ yadm.hostname }} = ["common", "gui", "work"]
{% else %}
{{ yadm.hostname }} = ["common", "gui", "default"]
{% endif %}
{% endif %}
