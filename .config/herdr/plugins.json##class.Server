    "plugin_root": "/home/joe/.config/herdr/plugins/github/jt.command-palette-24905dca5f16",
    "enabled": true,
    "platforms": [
      "linux",
      "macos"
    ],
    "actions": [
      {
        "id": "open",
        "title": "Command palette (all plugin actions)",
        "contexts": [
          "workspace"
        ],
        "command": [
          "bash",
          "open.sh"
        ]
      }
    ],
    "panes": [
      {
        "id": "palette",
        "title": "Command palette",
        "placement": "overlay",
        "command": [
          "bash",
          "-c",
          "exec \"$HERDR_PLUGIN_ROOT/palette.sh\""
        ]
      }
    ],
