{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "plugins": [
    "opencode-rules@next",
    {
      "package": "opencode-dcp@latest",
      "options": {
        "enabled": true,
        "debug": false,
        "allowSubAgents": false,
        "maxContextLimit": "85%",
        "nudgeFrequency": 5,
        "iterationNudgeThreshold": 15,
        "protectedTools": [],
        "protectedFilePatterns": [],
        "tui": {
          "enabled": true
        },
        "strategies": {
          "deduplication": {
            "enabled": true,
            "protectedTools": []
          },
          "purgeErrors": {
            "enabled": true,
            "turns": 4,
            "protectedTools": []
          }
        }
      }
    },
  ],
  "mcp": {
    "servers": {
      "docs": {
        "type": "remote",
        "url": "{env:MCP_GROUNDED_URL}",
        "headers": {
          "Authorization": "Bearer {env:MCP_GROUNDED_API_KEY}",
        },
        "disabled": false,
      },
      "web": {
        "type": "local",
        "command": ["donsetch", "mcp"],
        "disabled": false,
      },
      "chrome-devtools": {
        "type": "local",
        "command": ["aubx", "chrome-devtools-mcp@latest", "--browserUrl", "http://127.0.0.1:9222"],
        "disabled": true,
      },
      "openship": {
        "type": "remote",
        "url": "https://ship.maples.dev/api/mcp",
        "disabled": true,
      },
    },
  },
  "lsp": {
    "kotlin": {
      "command": ["kotlin-language-server"],
      "extensions": [".kt", ".kts"],
    },
    "pyright": {
      "disabled": true,
    },
    "basedpyright": {
      "command": ["basedpyright-langserver", "--stdio"],
      "extensions": [".py", ".pyi"],
    },
    "makefile": {
      "command": [
        "uvx",
        "--from",
        "autotools-language-server",
        "make-language-server",
      ],
      "extensions": ["Makefile", ".mk"],
    },
  },
  "formatter": {
    "mbake": {
      "command": ["uvx", "mbake", "format", "$FILE"],
      "extensions": ["Makefile", ".mk"],
    },
  },
  "permissions": [
    { "action": "websearch", "resource": "*", "effect": "deny" },
    { "action": "codesearch", "resource": "*", "effect": "deny" },
    { "action": "webfetch", "resource": "*", "effect": "deny" },
    { "action": "docs_fetch_url", "resource": "*", "effect": "deny" },
    { "action": "shell", "resource": "git filter-branch *", "effect": "deny" },
    { "action": "shell", "resource": "git branch -d", "effect": "ask" },
    { "action": "shell", "resource": "git branch -D", "effect": "ask" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "sudo *", "effect": "ask" },
  ],
  "compaction": {
    "auto": false,
  },
  "agents": {
    "title": {
      "model": "opencode/big-pickle",
    },
    "build": {
      "system": "{file:prompts/core.md}",
    },
    "plan": {
      "system": "{file:prompts/core.md}",
    },
    "explore": {
      "model": "ollama-cloud/deepseek-v4.1-flash#high",
    },
    "programmer": {
      "model": "ollama-cloud/deepseek-v4.1-flash#max",
    },
    "code-reviewer": {
      "model": "ollama-cloud/glm-5.3-flash#max",
    },
    "document-reviewer": {
      "model": "ollama-cloud/glm-5.3-flash#max",
    },
  },
}
