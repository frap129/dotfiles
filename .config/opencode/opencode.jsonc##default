{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "neuralwatt/openai/gpt-oss-20b",
  "default_agent": "main",
  "plugin": [
    "opencode-rules@beta",
    "@tarquinen/opencode-dcp@beta",
  ],
  "experimental": {
    "primary_tools": ["prune"],
    "batch_tool": true,
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "aubx",
        "-y",
        "@upstash/context7-mcp",
        "--api-key",
        "{env:CONTEXT7_API_KEY}",
      ],
      "enabled": false,
    },
    "general": {
      "type": "remote",
      "url": "{env:MCP_SEARXNG_URL}",
      "headers": {
        "Authorization": "Bearer {env:MCP_SEARXNG_API_KEY}",
      },
      "enabled": true,
    },
    "code": {
      "type": "remote",
      "url": "{env:MCP_SEARXNG_CODE_URL}",
      "headers": {
        "Authorization": "Bearer {env:MCP_SEARXNG_API_KEY}",
      },
      "enabled": true,
    },
    "web": {
      "type": "local",
      "command": [
        "aubx",
        "-y",
        "intercept-mcp@latest",
      ],
      "environment": {
        "USE_STEALTH_FETCH": "true"
      },
      "enabled": true,
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["aubx", "chrome-devtools-mcp@latest", "--browserUrl", "http://127.0.0.1:9222"],
      "enabled": false
    }
  },
  "lsp": {
    "kotlin": {
      "command": ["kotlin-language-server"],
      "extensions": [".kt", ".kts"],
    },
    "pyright": {
      "disabled": true,
    },
    "basedpyright": {
      "command": ["basedpyright-langserver", "--stdio"],
      "extensions": [".py", ".pyi"],
    },
    "makefile": {
      "command": [
        "uvx",
        "--from",
        "autotools-language-server",
        "make-language-server",
      ],
      "extensions": ["Makefile", ".mk"],
    },
  },
  "formatter": {
    "mbake": {
      "command": ["uvx", "mbake", "format", "$FILE"],
      "extensions": ["Makefile", ".mk"],
    },
  },
  "permission": {
    "general_web_url_read": "deny",
    "general_searxng_instance_info": "deny",
    "general_searxng_search_suggestions": "deny",
    "code_web_url_read": "deny",
    "code_searxng_instance_info": "deny",
    "code_searxng_search_suggestions": "deny",
    "web_search": "deny",
    "web_research": "deny",
    "websearch": "deny",
    "codesearch": "deny",
    "webfetch": "deny",
    "bash": {
      "git filter-branch *": "deny",
      "git branch -d": "ask",
      "git branch -D": "ask",
      "git push *": "ask",
      "sudo *": "ask",
    },
  },
  "compaction": {
    "auto": false,
    "prune": true,
  },
  "agent": {
    "general": {
      "variant": "high",
    },
    "explore": {
      "model": "opencode-go/deepseek-v4-flash",
      "variant": "high",
    },
    "programmer": {
      "model": "opencode-go/deepseek-v4-flash",
      "variant": "max",
    },
    "code-reviewer": {
      "model": "opencode-go/deepseek-v4-flash",
      "variant": "max",
    },
    "document-reviewer": {
      "model": "opencode-go/deepseek-v4-flash",
      "variant": "max",
    }
  }
}
