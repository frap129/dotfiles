{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "opencode-go/deepseek-v4-flash",
  "default_agent": "main",
  "plugin": [
    "opencode-rules@latest",
    "@tarquinen/opencode-dcp@beta",
  ],
  "experimental": {
    "primary_tools": ["prune"],
    "batch_tool": true,
  },
  "mcp": {
    "docs": {
      "type": "remote",
      "url": "{env:MCP_GROUNDED_URL}",
      "headers": {
        "Authorization": "Bearer {env:MCP_GROUNDED_API_KEY}",
      },
      "enabled": true,
    },
    "web": {
      "type": "local",
      "command": ["donsetch", "mcp"],
      "enabled": true,
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["aubx", "chrome-devtools-mcp@latest", "--browserUrl", "http://127.0.0.1:9222"],
      "enabled": false
    },
    "openship": {
      "type": "remote",
      "url": "https://ship.maples.dev/api/mcp",
      "enabled": false
    }
  },
  "lsp": {
    "kotlin": {
      "command": ["kotlin-language-server"],
      "extensions": [".kt", ".kts"],
    },
    "pyright": {
      "disabled": true,
    },
    "basedpyright": {
      "command": ["basedpyright-langserver", "--stdio"],
      "extensions": [".py", ".pyi"],
    },
    "makefile": {
      "command": [
        "uvx",
        "--from",
        "autotools-language-server",
        "make-language-server",
      ],
      "extensions": ["Makefile", ".mk"],
    },
  },
  "formatter": {
    "mbake": {
      "command": ["uvx", "mbake", "format", "$FILE"],
      "extensions": ["Makefile", ".mk"],
    },
  },
  "permission": {
    "websearch": "deny",
    "codesearch": "deny",
    "webfetch": "deny",
    "docs_fetch_url": "deny",
    "bash": {
      "git filter-branch *": "deny",
      "git branch -d": "ask",
      "git branch -D": "ask",
      "git push *": "ask",
      "sudo *": "ask",
    },
  },
  "compaction": {
    "auto": false,
    "prune": true,
  },
  "agent": {
    "build": {
      "prompt": "{file:prompts/core.md}",
    },
    "plan": {
      "prompt": "{file:prompts/core.md}",
    },
    "general": {
      "variant": "high",
    },
    "explore": {
      "model": "opencode-go/deepseek-v4-flash",
      "variant": "high",
    },
    "programmer": {
      "model": "opencode-go/deepseek-v4-flash",
      "variant": "max",
    },
    "code-reviewer": {
      "model": "opencode-go/deepseek-v4-flash",
      "variant": "max",
    },
    "document-reviewer": {
      "model": "opencode-go/deepseek-v4-flash",
      "variant": "max",
    }
  },
}
