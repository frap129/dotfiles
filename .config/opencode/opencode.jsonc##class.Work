{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "share": "disabled",
  "plugins": [
    "opencode-rules@next",
    {
      "package": "opencode-dcp@2.0.0-beta.9",
      "options": {
        "enabled": true,
        "debug": false,
        "allowSubAgents": false,
        "maxContextLimit": "85%",
        "nudgeFrequency": 5,
        "iterationNudgeThreshold": 15,
        "protectedTools": [],
        "protectedFilePatterns": [],
        "tui": { "enabled": true },
        "strategies": {
          "deduplication": {
            "enabled": true,
            "protectedTools": [],
          },
          "purgeErrors": {
            "enabled": true,
            "turns": 4,
            "protectedTools": [],
          },
        },
      },
    },
  ],
  "mcp": {
    "servers": {
      "docs": {
        "type": "remote",
        "url": "{env:MCP_GROUNDED_URL}",
        "headers": {
          "Authorization": "Bearer {env:MCP_GROUNDED_API_KEY}",
        },
        "disabled": false,
      },
      "chrome-dev-tools": {
        "type": "local",
        "command": ["aubx", "-y", "chrome-devtools-mcp@latest"],
        "disabled": true,
      },
      "android": {
        "type": "local",
        "command": ["aubx", "-y", "android-mcp-server@latest"],
        "disabled": true,
      },
      "web": {
        "type": "local",
        "command": ["donsetch", "mcp"],
        "disabled": false,
      },
      "smartsheet": {
        "type": "remote",
        "url": "https://mcp.smartsheet.com",
        "headers": {
          "Authorization": "Bearer {env:SMARTSHEET_API_TOKEN}",
        },
        "disabled": true,
      },
      "figma": {
        "type": "local",
        "command": [
          "aubx",
          "-y",
          "figma-developer-mcp",
          "--figma-api-key={env:FIGMA_API_TOKEN}",
          "--stdio",
        ],
        "disabled": true,
      },
      "atlassian": {
        "type": "remote",
        "url": "https://mcp.atlassian.com/v1/mcp",
        "disabled": true,
      },
      "memory": {
        "type": "local",
        "command": ["/home/joe/.hermes/hermes-agent/venv/bin/mnemosyne", "mcp"],
        "disabled": false,
      },
    },
  },
  "lsp": {
    "kotlin": {
      "command": ["kotlin-language-server"],
      "extensions": [".kt", ".kts"],
    },
    "pyright": {
      "disabled": true,
    },
    "basedpyright": {
      "command": ["basedpyright-langserver", "--stdio"],
      "extensions": [".py", ".pyi"],
    },
    "makefile": {
      "command": [
        "uvx",
        "--from",
        "autotools-language-server",
        "make-language-server",
      ],
      "extensions": ["Makefile", ".mk"],
    },
  },
  "formatter": {
    "mbake": {
      "command": ["uvx", "mbake", "format", "$FILE"],
      "extensions": ["Makefile", ".mk"],
    },
  },
  "permissions": [
    { "action": "atlassian_*", "resource": "*", "effect": "deny" },
    { "action": "atlassian_getConfluencePage", "resource": "*", "effect": "allow" },
    { "action": "atlassian_getConfluencePageDescendants", "resource": "*", "effect": "allow" },
    { "action": "atlassian_getConfluencePageFooterComments", "resource": "*", "effect": "allow" },
    { "action": "atlassian_getConfluencePageInlineComments", "resource": "*", "effect": "allow" },
    { "action": "atlassian_getConfluenceCommentChildren", "resource": "*", "effect": "allow" },
    { "action": "atlassian_getConfluenceSpaces", "resource": "*", "effect": "allow" },
    { "action": "atlassian_getPagesInConfluenceSpace", "resource": "*", "effect": "allow" },
    { "action": "atlassian_searchConfluenceUsingCql", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "deny" },
    { "action": "codesearch", "resource": "*", "effect": "deny" },
    { "action": "webfetch", "resource": "*", "effect": "deny" },
    { "action": "docs_fetch_url", "resource": "*", "effect": "deny" },
    { "action": "prune", "resource": "*", "effect": "allow" },
  ],
  "compaction": {
    "auto": false,
  },
  "agents": {
    "title": {
      "model": "github-copilot/gpt-5.6-luna",
    },
    "build": {
      "system": "{file:prompts/core.md}",
    },
    "plan": {
      "system": "{file:prompts/core.md}",
    },
    "explore": {
      "model": "github-copilot/gpt-5.6-luna#high",
    },
    "programmer": {
      "model": "github-copilot/gemini-3.8-flash#high",
    },
    "code-reviewer": {
      "model": "github-copilot/gemini-3.8-flash#high",
    },
    "document-reviewer": {
      "model": "github-copilot/gpt-5.6-luna#high",
    },
  },
  "providers": {
    "github-copilot": {
      "models": {
        "gpt-5.6-sol": {
          "limit": {
            "context": 272000,
            "output": 128000,
          },
        },
        "gpt-6-astra": {
          "limit": {
            "context": 272000,
            "output": 128000,
          },
        },
      },
    },
  },
}
