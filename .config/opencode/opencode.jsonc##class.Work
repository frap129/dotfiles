{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "github-copilot/gpt-5-mini",
  "default_agent": "main",
  "share": "disabled",
  "plugin": [
    "opencode-rules@latest",
    "@tarquinen/opencode-dcp@latest",
    "file:///home/joe/projects/opencode-fordllm/src/fordllm.ts",
  ],
  "experimental": {
    "batch_tool": true,
  },
  "mcp": {
    "docs": {
      "type": "remote",
      "url": "{env:MCP_GROUNDED_URL}",
      "headers": {
        "Authorization": "Bearer {env:MCP_GROUNDED_API_KEY}",
      },
      "enabled": true,
    },
    "chrome-dev-tools": {
      "type": "local",
      "command": ["aubx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": false,
    },
    "android": {
      "type": "local",
      "command": ["aubx", "-y", "android-mcp-server@latest"],
      "enabled": false,
    },
    "web": {
      "type": "local",
      "command": ["donsetch", "mcp"],
      "enabled": true,
    },
    "smartsheet": {
      "type": "remote",
      "url": "https://mcp.smartsheet.com",
      "headers": {
        "Authorization": "Bearer {env:SMARTSHEET_API_TOKEN}",
      },
      "enabled": false,
    },
    "figma": {
      "type": "local",
      "command": [
        "aubx",
        "-y",
        "figma-developer-mcp",
        "--figma-api-key={env:FIGMA_API_TOKEN}",
        "--stdio",
      ],
      "enabled": false,
    },
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp",
      "enabled": false,
    },
    "memory": {
      "enabled": true,
      "type": "local",
      "command": ["/home/joe/.hermes/hermes-agent/venv/bin/mnemosyne", "mcp"],
    },
  },
  "lsp": {
    "kotlin": {
      "command": ["kotlin-language-server"],
      "extensions": [".kt", ".kts"],
    },
    "pyright": {
      "disabled": true,
    },
    "basedpyright": {
      "command": ["basedpyright-langserver", "--stdio"],
      "extensions": [".py", ".pyi"],
    },
    "makefile": {
      "command": [
        "uvx",
        "--from",
        "autotools-language-server",
        "make-language-server",
      ],
      "extensions": ["Makefile", ".mk"],
    },
  },
  "formatter": {
    "mbake": {
      "command": ["uvx", "mbake", "format", "$FILE"],
      "extensions": ["Makefile", ".mk"],
    },
  },
  "permission": {
    "atlassian_*": "deny",
    "atlassian_getConfluencePage": "allow",
    "atlassian_getConfluencePageDescendants": "allow",
    "atlassian_getConfluencePageFooterComments": "allow",
    "atlassian_getConfluencePageInlineComments": "allow",
    "atlassian_getConfluenceCommentChildren": "allow",
    "atlassian_getConfluenceSpaces": "allow",
    "atlassian_getPagesInConfluenceSpace": "allow",
    "atlassian_searchConfluenceUsingCql": "allow",
    "websearch": "deny",
    "codesearch": "deny",
    "webfetch": "deny",
    "docs_fetch_url": "deny"
  },
  "compaction": {
    "auto": false,
    "prune": false,
  },
  "agent": {
    "build": {
      "prompt": "{file:prompts/core.md}",
    },
    "plan": {
      "prompt": "{file:prompts/core.md}",
    },
    "explore": {
      "model": "github-copilot/gpt-5.6-luna",
      "variant": "high",
    },
    "programmer": {
      "model": "github-copilot/gpt-5.6-luna",
      "variant": "high",
    },
    "code-reviewer": {
      "model": "github-copilot/gpt-5.6-terra",
      "variant": "high",
    },
    "document-reviewer": {
      "model": "github-copilot/gpt-5.6-luna",
      "variant": "high",
    },
  },
  "provider": {
    "github-copilot": {
      "models": {
        "claude-opus-4.6": {
          "options": {
            "thinking": {
              "type": "enabled",
            },
            "thinking_budget": 4000,
          },
          "variants": {
            "high": {
              "thinking": {
                "type": "enabled",
              },
              "thinking_budget": 32000,
            },
            "medium": {
              "thinking": {
                "type": "enabled",
              },
              "thinking_budget": 16000,
            },
            "low": {
              "thinking": {
                "type": "enabled",
              },
              "thinking_budget": 8000,
            },
          },
        },
      },
    },
    "fordllm": {
      "name": "FordLLM",
    },
  },
}
