#!/usr/bin/env bash
set -euo pipefail

case "${1-} ${2-}" in
  "list --global")
    aube list --global --json | jq '{dependencies: (map({key: .name, value: {version: .version}}) | from_entries)}'
    ;;
  "install --global")
    shift 2
    allow_builds=()
    packages=()
    for package in "$@"; do
      case "$package" in
        @fission-ai/openspec|opencode-ai) allow_builds+=("--allow-build=$package") ;;
      esac
      case "$package" in
        conventional-changelog) packages+=("conventional-changelog@8.1.0") ;;
        *) packages+=("$package") ;;
      esac
    done
    exec aube add --global "${allow_builds[@]}" "${packages[@]}"
    ;;
  "uninstall --global")
    shift 2
    exec aube remove --global "$@"
    ;;
  "update --global")
    shift 2
    update_packages=()
    pin_changelog=false
    for package in "$@"; do
      case "$package" in
        conventional-changelog) pin_changelog=true ;;
        *) update_packages+=("$package") ;;
      esac
    done
    if ((${#update_packages[@]})); then
      aube update --global --latest "${update_packages[@]}"
    fi
    if [[ $pin_changelog == true ]]; then
      exec aube add --global conventional-changelog@8.1.0
    fi
    ;;
  "cache clean")
    exec aube store prune
    ;;
  *)
    exec aube "$@"
    ;;
esac
