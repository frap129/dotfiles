#!/usr/bin/env bash
set -euo pipefail

case "${1-} ${2-}" in
  "list --global")
    aube list --global --json | jq '{dependencies: (map(. as $package | [
      {key: $package.name, value: {version: $package.version}},
      {key: ($package.name + "@" + $package.version), value: {version: $package.version}}
    ]) | flatten | from_entries)}'
    ;;
  "install --global")
    shift 2
    allow_builds=()
    for package in "$@"; do
      if [[ "$package" == @* ]]; then
        name="${package%@*}"
        [[ -n "$name" ]] || name="$package"
      else
        name="${package%%@*}"
      fi
      allow_builds+=("--allow-build=$name")
    done
    exec aube add --global "${allow_builds[@]}" "$@"
    ;;
  "uninstall --global")
    shift 2
    exec aube remove --global "$@"
    ;;
  "update --global")
    shift 2
    for package in "$@"; do
      if [[ "$package" == @* ]]; then
        name="${package%@*}"
        [[ -n "$name" ]] || name="$package"
      else
        name="${package%%@*}"
      fi
      spec="$package"
      [[ "$package" == "$name" ]] && spec="$package@latest"
      aube add --global "--allow-build=$name" "$spec"
    done
    ;;
  "cache clean")
    exec aube store prune
    ;;
  *)
    exec aube "$@"
    ;;
esac
