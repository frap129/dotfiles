#
# Common shell rc config
#

# get current shell
if [ -z "${BASH_VERSINFO+x}" ]; then
    local shell="zsh"
else
    shell="bash"
fi

# Environment Variables
export GOPATH=~/.cache/go
export color_prompt=yes
if [[ $(command -v ccache) ]]; then
  export USE_CCACHE=1
  export CCACHE_DIR=~/.ccache
  export CCACHE_EXEC=$(command -v ccache)
  export CCACHE_COMPRESS=1
fi
export ANDROID_HOME=~/Android/Sdk

# Environment setup scripts
[[ -f ~/.hostrc ]] && source ~/.hostrc
[[ -f ~/.local/bin/snv ]] && source ~/.local/bin/snv
[[ -d ~/Android/platform-tools ]] && export PATH=~/Android/platform-tools:$PATH
export PATH="$HOME/.nix-profile/bin:$PATH"
export npm_config_prefix="$HOME/.local"
export AUBE_RUNTIME_INSTALLER=aube
[[ $(command -v aube) ]] && eval "$(aube activate "$shell")"
export PATH="$HOME/.local/bin:${XDG_DATA_HOME:-$HOME/.local/share}/pnpm:$HOME/.cargo/bin:$PATH"
[[ $(command -v tirith) ]] && eval "$(tirith init --shell $shell)" >/dev/null

# Aliases and functions
alias grep='grep --color=auto'
alias mkdir="mkdir -pv"
alias fhere="find . -name "
alias free="free -mt"
alias wget="wget -c"
alias histg="history | grep"
alias rwaybar='killall -SIGUSR2 waybar'
alias vi="nvim"
alias myip="curl http://ipecho.net/plain; echo"
alias adate='adb shell date $(date +%m%d%H%M%Y.%S)'
alias spec='openspec'

# Common replacements
[[ $(command -v delta) ]] && alias diff="delta"
[[ $(command -v bat) ]] && alias cat="bat -pp"
[[ $(command -v eza) ]] && alias ls="eza -hg --icons --group-directories-first"
[[ $(command -v thefuck) ]] && eval "$(thefuck --alias)"
[[ $(command -v dust) ]] && alias du="dust"
[[ $(command -v zoxide) ]] && eval "$(zoxide init $shell --cmd cd)"
[[ $(command -v aubx) ]] && alias bunx='aubx'
[[ $(command -v ugrep) ]] && alias grep="ugrep" && \
  alias rg='ugrep -r --ignore-files --ignore-files=.ignore --ignore-files=.rgignore -I -n --heading --break --color' && \
  alias ag='ug -r --ignore-files -I -n --heading --break --color -j --sort'

# Workstation environment
if [[ $(command -v nix) ]]; then
  setup-workstation() {
    local arg dry_run=false

    for arg in "$@"; do
      case "$arg" in
        -n|--dry-run) dry_run=true ;;
      esac
    done

    if [[ "$dry_run" == true ]]; then
      nix build nixpkgs#metapac --dry-run --no-link || return
      command -v metapac >/dev/null && command -v yadm >/dev/null || {
        printf 'setup-workstation: install metapac before first dry run\n' >&2
        return 1
      }
    else
      yadm alt || return
      if nix profile list --json | command grep -q '"nix-env"'; then
        nix profile remove nix-env || return
      fi
      for bootstrap_package in metapac aube cargo cargo-binstall jq rustc uv; do
        if ! nix profile list --json | command grep -q "\"$bootstrap_package\""; then
          nix profile install "nixpkgs#$bootstrap_package" || return
        fi
      done
      hash -r
    fi

    if [[ "$dry_run" == true ]]; then
      metapac unmanaged || return
      printf 'setup-workstation: dry run skips metapac sync\n'
    else
      metapac sync --no-confirm
    fi
  }
fi

# Prompt
eval "$(oh-my-posh init $shell --config ~/.config/oh-my-posh.json)"
