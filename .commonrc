#
# Common shell rc config
#

# get current shell
if [ -z "${BASH_VERSINFO+x}" ]; then
  local shell="zsh"
else
  shell="bash"
fi

# Environment Variables
export color_prompt=yes

# Import environment from .config/environment.d
set -a
for file in "$HOME"/.config/environment.d/*.conf; do
  [ -r "$file" ] || continue
  . "$file"
done
unset file
set +a

# Environment setup scripts
[[ -f ~/.hostrc ]] && source ~/.hostrc
[[ $(command -v tirith) ]] && eval "$(tirith init --shell $shell 2>/dev/null)"
[[ $(command -v zoxide) ]] && eval "$(zoxide init $shell --cmd cd)"
[[ $(command -v atuin) ]] && eval "$(atuin init $shell)"
[[ $(command -v carapace) ]] && source <(carapace _carapace)

# Aliases
if [[ $(command -v ug) ]]; then
  alias grep='ug -G'
  alias egrep='ug -E'
  alias ag='ug -r --ignore-files -I -n --heading --break --color -j --sort'
  alias rg='ug -r --ignore-files --ignore-files=.ignore --ignore-files=.rgignore -I -n --heading --break --color'
fi
if [[ $(command -v nvim) ]]; then
  alias vi=nvim
  alias vim=nvim
  alias emacs=nvim
fi
[[ $(command -v adb) ]] && alias adate='sh -c '"'"'adb shell date $(date +%m%d%H%M%Y.%S)'"'"''
[[ $(command -v aubx) ]] && alias bunx=aubx
[[ $(command -v bat) ]] && alias cat='bat -pp'
[[ $(command -v delta) ]] && alias diff=delta
[[ $(command -v dust) ]] && alias du=dust
[[ $(command -v eza) ]] && alias ls="eza -hg --icons --group-directories-first"
alias fhere='find . -name'
alias myip='curl http://ipecho.net/plain ; echo'

# Prompt
eval "$(oh-my-posh init $shell --config ~/.config/oh-my-posh.json)"
