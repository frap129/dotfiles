#
# Common shell rc config
#

# get current shell
if [ -z "${BASH_VERSINFO+x}" ]; then
    local shell="zsh"
else
    shell="bash"
fi

# Environment Variables
export GOPATH=~/.cache/go
export color_prompt=yes
if [[ $(command -v ccache) ]]; then
  export USE_CCACHE=1
  export CCACHE_DIR=~/.ccache
  export CCACHE_EXEC=$(command -v ccache)
  export CCACHE_COMPRESS=1
fi
export ANDROID_HOME=~/Android/Sdk

# Environment setup scripts
[[ -f ~/.hostrc ]] && source ~/.hostrc
[[ -f ~/.local/bin/snv ]] && source ~/.local/bin/snv
[[ -d ~/Android/platform-tools ]] && export PATH=~/Android/platform-tools:$PATH
export npm_config_prefix="$HOME/.local"
[[ $(command -v mise) ]] && eval "$(mise activate "$shell")"

# Aliases and functions
alias grep='grep --color=auto'
alias df="df -ahiT --total"
alias mkdir="mkdir -pv"
alias fhere="find . -name "
alias free="free -mt"
alias wget="wget -c"
alias histg="history | grep"
alias rwaybar='killall -SIGUSR2 waybar'
alias vi="nvim"
alias myip="curl http://ipecho.net/plain; echo"
alias adate='adb shell date $(date +%m%d%H%M%Y.%S)'
alias spec='openspec'

# Common replacements
[[ $(command -v delta) ]] && alias diff="delta"
[[ $(command -v bat) ]] && alias cat="bat -pp"
[[ $(command -v eza) ]] && alias ls="eza -hg --icons --group-directories-first"
[[ $(command -v thefuck) ]] && eval "$(thefuck --alias)"
[[ $(command -v dust) ]] && alias du="dust"
[[ $(command -v zoxide) ]] && eval "$(zoxide init $shell --cmd cd)"
[[ $(command -v aubx) ]] && alias npx='aubx' && alias bunx='aubx'
[[ $(command -v ugrep) ]] && alias grep="ugrep" && \
  alias rg='ugrep -r --ignore-files --ignore-files=.ignore --ignore-files=.rgignore -I -n --heading --break --color' && \
  alias ag='ug -r --ignore-files -I -n --heading --break --color -j --sort'

# Nix development environment
if [[ $(command -v nix) ]]; then
  setup-workstation() {
    local arg classes profile repo_git dry_run=false

    for arg in "$@"; do
      case "$arg" in
        -n|--dry-run) dry_run=true ;;
        -E|--env|--env=*)
          printf 'setup-workstation: yadm class selects mise environment\n' >&2
          return 2
          ;;
      esac
    done

    repo_git="${XDG_DATA_HOME:-$HOME/.local/share}/yadm/repo.git"
    command -v git >/dev/null && [[ -d "$repo_git" ]] || {
      printf 'setup-workstation: yadm repository unavailable\n' >&2
      return 1
    }
    classes=$(git --git-dir="$repo_git" config --get-all local.class 2>/dev/null || true)
    case "$classes" in
      "") profile=Default ;;
      Work|Server) profile=$classes ;;
      *)
        printf 'setup-workstation: invalid yadm class set: %s\n' "$classes" >&2
        return 2
        ;;
    esac

    if [[ "$dry_run" == true ]]; then
      if nix profile list --json | command grep -q '"nix-env"'; then
        nix profile upgrade nix-env --dry-run || return
      else
        nix build ~/.config/nix-env#default --dry-run --no-link || return
      fi
      command -v mise >/dev/null && command -v yadm >/dev/null || {
        printf 'setup-workstation: apply Nix profile before first dry run\n' >&2
        return 1
      }
    else
      if nix profile list --json | command grep -q '"nix-env"'; then
        nix profile upgrade nix-env || return
      else
        nix profile add ~/.config/nix-env || return
      fi
      hash -r
    fi

    if [[ "$dry_run" != true ]]; then
      yadm alt || return
    fi

    env MISE_ENV="$profile" mise -C "$HOME" bootstrap "$@"
  }
fi
